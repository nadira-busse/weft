{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nadira-busse/weft/schemas/archive-conversation/request.schema.json",
  "title": "archive_conversation request",
  "description": "Public request contract derived from the exported archive_conversation input specification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conversation_id",
    "conversation_title",
    "project",
    "extraction_type",
    "start_time",
    "message_count",
    "messages"
  ],
  "properties": {
    "conversation_id": {
      "description": "Stable request identity. Leading and trailing whitespace are ignored; at least one non-whitespace character is required.",
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "conversation_title": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "minLength": 1 },
    "extraction_type": { "type": "string", "minLength": 1 },
    "start_time": {
      "description": "Local 24-hour time (HH:mm) or an ISO 8601 datetime.",
      "oneOf": [
        { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" },
        { "type": "string", "format": "date-time" }
      ]
    },
    "end_time": {
      "description": "Optional local 24-hour time (HH:mm) or ISO 8601 datetime. The scenario uses the current time when this field is empty or omitted.",
      "oneOf": [
        { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" },
        { "type": "string", "format": "date-time" }
      ]
    },
    "message_count": { "type": "number", "minimum": 1 },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "content": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": { "type": "string" },
    "action_items": { "type": "string" },
    "key_insights": { "type": "string" },
    "categories": { "type": "string" },
    "source": { "type": "string" },
    "source_platform": { "type": "string" },
    "payload_json": { "type": "string" },
    "status": { "type": "string" },
    "priority": { "type": "string", "default": "Normal" },
    "sentiment": { "type": "string" }
  }
}
