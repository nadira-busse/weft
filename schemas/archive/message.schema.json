{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/archive/message.schema.json",
  "title": "Archive Message",
  "description": "Single ordered message inside a conversation archive payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role",
    "content"
  ],
  "properties": {
    "role": {
      "type": "string",
      "minLength": 1,
      "description": "Role of the message sender, such as user, assistant or system."
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "description": "Content of the archived message."
    }
  }
}