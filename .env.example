# Copy this file to .env. Add private values only to .env.

# Make zone shown at the start of your Make URL, for example eu1 or eu2
MAKE_ZONE=

# One Make API token with these permissions:
# connections:read, organizations:read, scenarios:read, scenarios:write,
# teams:read, udts:read, udts:write
MAKE_API_TOKEN=

# Notion internal integration token used for read-only installer discovery
NOTION_INSPECT_TOKEN=

# Filled automatically by: python -m installer configure
MAKE_API_BASE_URL=
MAKE_ORGANIZATION_ID=
MAKE_TEAM_ID=

# Optional disambiguation; leave empty when exactly one valid connection exists
WEFT_NOTION_CONNECTION_ID=
WEFT_AI_CONNECTION_ID=

# Optional naming/state overrides; the state path must remain under .weft-installer/
WEFT_INSTALLATION_NAME=
WEFT_STATE_FILE=
