# Normalize text files in the repository
* text=auto eol=lf

# Markdown / docs
*.md text eol=lf
*.txt text eol=lf

# Data / schemas / config
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env.example text eol=lf

# Code / scripts
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf

# Diagrams
*.svg text eol=lf

# Windows scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
